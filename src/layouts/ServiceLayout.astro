---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import { ui } from '../config/ui.ts';
import '../styles/global.css';

const { service } = Astro.props as { service: CollectionEntry<'services'> };
const pageTitle = service.data.title;
const description = service.data.description;
const canonical = `/layanan/${service.data.slug}/`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const serviceUrl = new URL(canonical, siteUrl).toString();
const serviceImageSource = service.data.socialImage ?? ui.meta.defaultImage;
const isRasterImage = /\.(png|jpe?g|webp|gif)$/i.test(serviceImageSource.split(/[?#]/)[0]);
const serviceImage = new URL(isRasterImage ? serviceImageSource : ui.meta.defaultImage, siteUrl).toString();
const utcIso = (date: Date) => date.toISOString().replace(/\.\d{3}Z$/, 'Z');
const serviceJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${serviceUrl}#service`,
  name: pageTitle,
  description,
  image: [serviceImage],
  url: serviceUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${serviceUrl}#webpage` },
  serviceType: pageTitle,
  provider: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: ui.brand.name,
    url: siteUrl,
  },
}).replace(/</g, '\\u003c');
---
<BaseLayout title={pageTitle} description={description} canonical={canonical} socialImage={service.data.socialImage ?? ui.meta.defaultImage} imageAlt={service.data.image ? service.data.imageAlt : ui.article.socialImageAlt} pubDate={service.data.pubDate} updatedDate={service.data.updatedDate} mainEntityId={`${serviceUrl}#service`}>
  <script slot="head" type="application/ld+json" set:html={serviceJsonLd}></script>
  <SiteHeader />
  <main id="main-content" class="mx-auto max-w-7xl px-5 py-10 sm:py-12 lg:py-14">
    <article class="prose-content min-w-0">
      <header class="mb-10 grid items-center gap-8 rounded-3xl border border-zinc-200 bg-gradient-to-br from-stone-50 via-white to-emerald-50/60 px-6 py-9 sm:px-8 md:grid-cols-[1.1fr_0.9fr] md:gap-12">
        <div class="max-w-3xl">
          {service.data.eyebrow && <p class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1 text-xs font-bold uppercase tracking-[0.14em] text-emerald-700">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
            {service.data.eyebrow}
          </p>}
          <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-zinc-950 md:text-4xl lg:text-5xl">{pageTitle}</h1>
          <p class="mt-4 text-lg leading-8 text-zinc-600">{description}</p>
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-sm text-zinc-500">
            <time datetime={utcIso(service.data.pubDate)}>{service.data.pubDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</time>
            <span>{ui.article.updatedPrefix} {service.data.updatedDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
          </div>
        </div>
        <img src={service.data.image ?? ui.services.defaultImage} alt={service.data.imageAlt} class="mx-auto w-full max-w-xl rounded-2xl object-contain ring-1 ring-zinc-200/70" width="560" height="420" fetchpriority="high" />
      </header>
      <div class="prose-content [&>h2]:scroll-mt-28 [&>h3]:scroll-mt-24"><slot /></div>
      <slot name="related" />
    </article>
  </main>
  <section class="bg-emerald-950 text-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-10 sm:flex-row sm:items-center sm:justify-between lg:py-12">
      <div class="max-w-2xl">
        <h2 class="font-display text-xl font-extrabold tracking-tight text-white">{ui.article.ctaHeading}</h2>
        <p class="mt-2 leading-7 text-emerald-100/85">{ui.article.ctaText}</p>
      </div>
      <a href="/layanan/" class="inline-flex shrink-0 items-center justify-center rounded-full bg-amber-400 px-6 py-3 text-sm font-bold text-emerald-950 no-underline transition hover:bg-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">{ui.article.ctaButton}</a>
    </div>
  </section>
  <SiteFooter category={service.data.serviceCategory} serviceTitle={pageTitle} />
</BaseLayout>
