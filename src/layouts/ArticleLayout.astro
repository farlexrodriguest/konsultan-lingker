---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import ArticlePreviousArticles from '../components/shared/ArticlePreviousArticles.astro';
import { ui } from '../config/ui.ts';
import '../styles/global.css';
const { article, headings = [] } = Astro.props as {
  article: CollectionEntry<'articles'>;
  headings?: Array<{ depth: number; text: string; slug: string }>;
};
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const articles = await getCollection('articles');
const hasPreviousArticles = articles.some((item) => !item.data.draft && item.data.contentType !== 'local-seo' && item.data.id < article.data.id);
const pageTitle = article.data.title;
const description = article.data.description;
const canonical = `/artikel/${article.data.slug}/`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const articleUrl = new URL(canonical, siteUrl).toString();
// Social metadata and JSON-LD use a dedicated raster image; the on-page illustration may remain SVG.
const articleImageSource = article.data.socialImage ?? ui.meta.articleImage;
const isRasterArticleImage = /\.(png|jpe?g|webp|gif)$/i.test(articleImageSource.split(/[?#]/)[0]);
const articleImage = new URL(isRasterArticleImage ? articleImageSource : ui.meta.defaultImage, siteUrl).toString();

const authorName = typeof article.data.author === 'object' ? article.data.author.name : article.data.author;
const authorUrl = typeof article.data.author === 'object' ? article.data.author.url : undefined;

let footerServiceTitle: string | undefined;
let relatedServiceHref = '/layanan/';
let articleCtaText = ui.article.ctaText;
let articleCtaButton = ui.article.ctaButton;
let relatedServiceJsonLd: any = null;

if (article.data.relatedType === 'service' && article.data.relatedId) {
  const services = await getCollection('services');
  const related = services.find((s) => s.data.id === article.data.relatedId && !s.data.draft && s.data.status === 'active');
  if (related) {
    footerServiceTitle = related.data.title;
    relatedServiceHref = `/layanan/${related.data.slug}/`;
    articleCtaText = `Pelajari layanan ${related.data.title} dan diskusikan kebutuhan lokasi serta sampel Anda bersama tim kami.`;
    articleCtaButton = 'Lihat layanan terkait';

    // Build related service JSON-LD
    const relServiceUrl = new URL(relatedServiceHref, siteUrl).toString();
    const relServiceImageSource = related.data.socialImage ?? ui.meta.defaultImage;
    const relIsRasterImage = /\.(png|jpe?g|webp|gif)$/i.test(relServiceImageSource.split(/[?#]/)[0]);
    const relServiceImage = new URL(relIsRasterImage ? relServiceImageSource : ui.meta.defaultImage, siteUrl).toString();

    relatedServiceJsonLd = {
      '@type': 'Service',
      '@id': `${relServiceUrl}#service`,
      name: related.data.title,
      description: related.data.description,
      image: [relServiceImage],
      url: relServiceUrl,
      provider: { '@id': `${siteUrl}/#organization` },
      ...(article.data.serviceArea ? { areaServed: article.data.serviceArea } : {}),
    };
  }
}
const categoriesBlock = article.data.blocks.find((block) => block.component === 'card' && block.id === 'kategori-utama');
const categoriesList = categoriesBlock && 'body' in categoriesBlock ? categoriesBlock.body.find((item): item is Extract<typeof item, { type: 'list' }> => item.type === 'list') : null;
const categoriesJsonLd = categoriesBlock && 'heading' in categoriesBlock && categoriesList ? {
  '@type': 'ItemList',
  '@id': `${articleUrl}#kategori-utama`,
  name: categoriesBlock.heading ?? 'Contoh kategori',
  itemListOrder: 'https://schema.org/ItemListUnordered',
  numberOfItems: categoriesList.items.length,
  itemListElement: categoriesList.items.map((name: string, index: number) => ({
    '@type': 'ListItem',
    position: index + 1,
    name,
  })),
} : null;
const faqBlock = article.data.blocks.find((block) => block.component === 'faq');
const faqJsonLd = faqBlock && 'items' in faqBlock ? {
  '@type': 'FAQPage',
  '@id': `${articleUrl}#faq`,
  inLanguage: 'id-ID',
  mainEntity: faqBlock.items.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const utcIso = (date: Date) => date.toISOString().replace(/\.\d{3}Z$/, 'Z');
const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': article.data.schemaType,
      '@id': `${articleUrl}#article`,
      headline: pageTitle,
      description,
      inLanguage: 'id-ID',
      image: [articleImage],
      datePublished: utcIso(article.data.pubDate),
      ...(article.data.updatedDate ? { dateModified: utcIso(article.data.updatedDate) } : {}),
      ...(authorName ? { author: { '@type': 'Person', name: authorName, ...(authorUrl ? { url: authorUrl } : {}) } } : {}),
      publisher: {
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        name: ui.brand.name,
        url: siteUrl,
        ...(article.data.serviceArea ? { areaServed: article.data.serviceArea } : {}),
      },

      ...(relatedServiceJsonLd ? { about: { '@id': relatedServiceJsonLd['@id'] } } : {}),
      mainEntityOfPage: { '@type': 'WebPage', '@id': `${articleUrl}#webpage` },
      url: articleUrl,
    },
    ...(relatedServiceJsonLd ? [relatedServiceJsonLd] : []),
    ...(categoriesJsonLd ? [categoriesJsonLd] : []),
    ...(faqJsonLd ? [faqJsonLd] : [])
  ]
}).replace(/</g, '\\u003c');
---
<BaseLayout title={pageTitle} description={description} canonical={canonical} socialImage={article.data.socialImage ?? ui.meta.articleImage} imageAlt={article.data.image ? `${ui.article.heroAltPrefix}${pageTitle}` : ui.article.socialImageAlt} pubDate={article.data.pubDate} updatedDate={article.data.updatedDate} mainEntityId={`${articleUrl}#article`}>
  <script slot="head" type="application/ld+json" set:html={articleJsonLd}></script>
  <meta slot="head" property="article:published_time" content={utcIso(article.data.pubDate)} />
  {article.data.updatedDate && <meta slot="head" property="article:modified_time" content={utcIso(article.data.updatedDate)} />}
  {authorName && <meta slot="head" property="article:author" content={authorName} />}
    <SiteHeader />
  <main id="main-content" class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-5 py-10 lg:grid-cols-[260px_minmax(0,1fr)] lg:py-14">
    {(tocItems.length > 0 || hasPreviousArticles) && (
      <aside class="self-start lg:sticky lg:top-24">
        {tocItems.length > 0 && <details class="rounded-2xl border border-zinc-200 bg-stone-50/70 p-4 lg:hidden">
          <summary class="cursor-pointer font-semibold text-zinc-800">{ui.article.tocMobile}</summary>
          <nav class="mt-3" aria-label={ui.article.tocAriaLabel}>
            <ul class="space-y-2 pl-4 text-sm">
              {tocItems.map((item) => <li class={item.depth === 3 ? 'ml-4' : ''}><a class="text-zinc-600 hover:text-emerald-700" href={`#${item.slug}`}>{item.text}</a></li>)}
            </ul>
          </nav>
        </details>}
        {tocItems.length > 0 && <nav class="hidden lg:block" aria-label={ui.article.tocAriaLabel}>
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-zinc-400">{ui.article.tocTitle}</p>
          <ul class="space-y-2 border-l-2 border-emerald-200 pl-4">
            {tocItems.map((item) => <li class={item.depth === 3 ? 'ml-4' : ''}><a class="text-sm text-zinc-600 no-underline hover:text-emerald-700" href={`#${item.slug}`}>{item.text}</a></li>)}
          </ul>
        </nav>}
        <ArticlePreviousArticles article={article} articles={articles} />
      </aside>
    )}
    <article class="prose-content min-w-0">
      <header class="mb-9 rounded-2xl border-b border-zinc-200 bg-stone-50/60 px-6 py-7">
        {article.data.category && <p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-700">{article.data.category}</p>}
        <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-zinc-950 md:text-4xl">{pageTitle}</h1>
        <p class="mt-4 text-lg leading-7 text-zinc-600">{description}</p>
        <img src={article.data.image ?? ui.article.defaultImage} alt={`${ui.article.inlineAltPrefix}${pageTitle}`} class="mt-6 w-full max-w-2xl rounded-2xl ring-1 ring-zinc-200/70" width="560" height="320" fetchpriority="high" />
        <div class="mt-5 flex flex-wrap items-center gap-4 text-sm text-zinc-500">
          <time datetime={utcIso(article.data.pubDate)}>{article.data.pubDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</time>
          {article.data.updatedDate && <span>{ui.article.updatedPrefix} {article.data.updatedDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</span>}
          {authorName && (
            <span>
              {ui.article.authorPrefix}{' '}
              {authorUrl ? (
                <a href={authorUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-500 underline decoration-zinc-300 underline-offset-4 transition hover:text-emerald-700 hover:decoration-emerald-700">
                  {authorName}
                </a>
              ) : (
                authorName
              )}
            </span>
          )}
        </div>
      </header>
      <div class="prose-content [&>h2]:scroll-mt-28 [&>h3]:scroll-mt-24"><slot /></div>
      <slot name="related" />
    </article>
  </main>
  <section class="bg-emerald-950 text-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-10 sm:flex-row sm:items-center sm:justify-between lg:py-12">
      <div class="max-w-2xl">
        <h2 class="font-display text-xl font-extrabold tracking-tight text-white">{ui.article.ctaHeading}</h2>
        <p class="mt-2 leading-7 text-emerald-100/85">{articleCtaText}</p>
      </div>
      <a href={relatedServiceHref} class="inline-flex shrink-0 items-center justify-center rounded-full bg-amber-400 px-6 py-3 text-sm font-bold text-emerald-950 no-underline transition hover:bg-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">{articleCtaButton}</a>
    </div>
  </section>
  <SiteFooter serviceTitle={footerServiceTitle} />
</BaseLayout>
