---
const { eyebrow, heading, message, image, homeCta, servicesCta, articlesCta } = Astro.props;
---
<div class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-5 py-20 text-center">
  <img src={image} alt="" aria-hidden="true" class="mb-8 w-full max-w-xs rounded-3xl" width="560" height="360" />
  <p class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1 text-xs font-bold uppercase tracking-[0.14em] text-emerald-700">{eyebrow}</p>
  <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight text-zinc-950 sm:text-5xl">{heading}</h1>
  <p class="mt-5 max-w-xl leading-7 text-zinc-600">{message}</p>
  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <a href="/" class="inline-flex items-center justify-center rounded-full bg-emerald-700 px-6 py-3 font-bold text-white no-underline hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700">{homeCta}</a>
    <a href="/layanan/" class="inline-flex items-center justify-center rounded-full border border-zinc-300 px-6 py-3 font-bold text-zinc-800 no-underline hover:bg-zinc-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700">{servicesCta}</a>
    <a href="/artikel/" class="inline-flex items-center justify-center rounded-full border border-zinc-300 px-6 py-3 font-bold text-zinc-800 no-underline hover:bg-zinc-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700">{articlesCta}</a>
  </div>
</div>
