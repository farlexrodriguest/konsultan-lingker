---
/**
 * ImagePanel — simple image with optional caption.
 *
 * Props:
 * - id: string — anchor id
 * - src: string — image source
 * - alt: string — alt text
 * - caption?: string — optional caption
 *
 * Usage:
 * <ImagePanel id="illustration-1" src="/images/service.svg" alt="SLF Service" caption="Gambaran layanan SLF" />
 */
import { ui } from '../../config/ui.ts';
const { id, src, alt, caption } = Astro.props;
---
<section id={id} class="py-12 bg-white" aria-label={ui.imagePanel.ariaLabel}>
  <div class="max-w-7xl mx-auto px-5">
    <div class="relative mx-auto max-w-4xl">
      <img src={src} alt={alt} class="w-full h-auto rounded-xl shadow-lg" loading="lazy" decoding="async" />
      {caption && <p class="mt-4 text-center text-sm text-zinc-500">{caption}</p>}
    </div>
  </div>
</section>