---
import { getCollection } from 'astro:content';
import { ui } from '../../config/ui.ts';
const { id, eyebrow, heading, description, variant = 'listing', columns = 3, showBenefits = false, category } = Astro.props;
const services = (await getCollection('services'))
  .filter((service) => !service.data.draft && service.data.status === 'active' && (!category || service.data.serviceCategory === category))
  .sort((a, b) => a.data.order - b.data.order);
const Heading = variant === 'home' ? 'h3' : 'h2';
const serviceBenefitItems = (service: import('astro:content').CollectionEntry<'services'>) => {
  const block = service.data.blocks.find((item) => item.component === 'feature-card-grid');
  return block?.items.slice(0, 3).map((item) => item.title) ?? [];
};
---
<section id={id} class={variant === 'home' ? 'scroll-mt-8 bg-white py-20 sm:py-24' : 'mt-10'}>
  <div class={variant === 'home' ? 'mx-auto max-w-7xl px-5' : ''}>
    {(eyebrow || heading || description) && <div class={variant === 'home' ? 'max-w-2xl' : 'max-w-3xl'}>
      {eyebrow && <p class="text-sm font-extrabold uppercase tracking-[0.14em] text-emerald-700">{eyebrow}</p>}
      {heading && <h2 class={variant === 'home' ? 'mt-3 font-display text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-4xl' : 'font-display text-2xl font-extrabold tracking-tight text-zinc-950'}>{heading}</h2>}
      {description && <p class="mt-4 leading-7 text-zinc-600">{description}</p>}
    </div>}
    {services.length ? <div class:list={[variant === 'home' ? 'mt-10 grid gap-5 md:grid-cols-3' : 'grid gap-5 md:grid-cols-2 lg:grid-cols-3', columns === 2 && 'md:grid-cols-2 lg:grid-cols-2']}>
      {services.map((service, index) => <article class:list={['flex h-full flex-col rounded-2xl border border-zinc-200 bg-white p-6 transition', variant === 'home' && 'hover:-translate-y-1 hover:border-emerald-300 hover:shadow-lg hover:shadow-emerald-900/5']}>
        {variant === 'home' ? <p class="font-display text-sm font-extrabold tracking-widest text-emerald-700">{String(index + 1).padStart(2, '0')}</p> : <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">{service.data.serviceCategory.toUpperCase()}</p>}
        <Heading class="mt-3 font-display text-xl font-extrabold leading-snug text-zinc-950">{service.data.title}</Heading>
        <p class="mt-3 flex-1 text-sm leading-7 text-zinc-600">{service.data.description}</p>
        {showBenefits && serviceBenefitItems(service).length > 0 && <ul class="mt-5 space-y-3 border-t border-zinc-100 pt-5 text-sm text-zinc-700">{serviceBenefitItems(service).map((point) => <li class="flex gap-2"><span class="font-bold text-emerald-700" aria-hidden="true">✓</span><span>{point}</span></li>)}</ul>}
        <a href={`/layanan/${service.data.slug}/`} class="mt-6 font-bold text-emerald-700 no-underline hover:text-emerald-900">{ui.services.readMore}</a>
      </article>)}
    </div> : <p class="mt-10 rounded-2xl border border-dashed border-zinc-300 p-8 text-zinc-500">{ui.services.emptyList}</p>}
  </div>
</section>
