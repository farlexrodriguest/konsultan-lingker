---
const { id, heading, items, class: css } = Astro.props;
---
<section id={id} class={`rounded-2xl border border-zinc-200 bg-white p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-6 text-2xl font-extrabold text-zinc-950 ${css?.heading ?? ''}`}>{heading}</h2>}
  <dl class={`space-y-4 ${css?.list ?? ''}`}>
    {items.map((item: any) => (
      <div class={`border-b border-zinc-100 pb-3 last:border-0 ${css?.item ?? ''}`}>
        <dt class={`font-semibold text-zinc-950 ${css?.term ?? ''}`}>{item.term}</dt>
        <dd class={`mt-1 text-sm leading-relaxed text-zinc-600 ${css?.definition ?? ''}`}>{item.definition}</dd>
      </div>
    ))}
  </dl>
</section>
