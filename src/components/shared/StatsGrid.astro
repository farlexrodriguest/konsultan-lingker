---
/**
 * StatsGrid — simple statistics grid.
 *
 * Props:
 * - id: string — anchor id
 * - items: Array<{value, label}> — stat items
 *
 * Usage:
 * <StatsGrid id="stats" items={[{value: "50+", label: "Proyek SLF"}, {value: "98%", label: "Tingkat Kelulusan"}]} />
 */
import { ui } from '../../config/ui.ts';
const { id, items } = Astro.props as { id: string; items: {value: string; label: string}[] };
---
<section id={id} class="py-12 bg-zinc-50" aria-label={ui.stats.ariaLabel}>
  <div class="max-w-7xl mx-auto px-5 stats-container grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((item: {value: string; label: string}) => (
      <div class="stat-card text-center">
        <p class="text-3xl font-bold text-emerald-600">{item.value}</p>
        <p class="text-sm text-zinc-500 mt-2">{item.label}</p>
      </div>
    ))}
  </div>
</section>