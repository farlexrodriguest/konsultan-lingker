---
const { id, heading, items, class: css } = Astro.props;
---
<section id={id} class={`rounded-2xl border border-zinc-200 bg-white p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-6 text-2xl font-extrabold text-zinc-950 ${css?.heading ?? ''}`}>{heading}</h2>}
  <div class={`grid gap-6 sm:grid-cols-2 ${css?.grid ?? ''}`}>
    {items.map((item: any) => (
      <div class={`rounded-xl border border-zinc-100 bg-zinc-50 p-5 text-center ${css?.item ?? ''}`}>
        <p class={`text-3xl font-extrabold text-emerald-700 ${css?.value ?? ''}`}>{item.value}</p>
        <p class={`mt-1 text-sm text-zinc-600 ${css?.label ?? ''}`}>{item.label}</p>
      </div>
    ))}
  </div>
</section>
