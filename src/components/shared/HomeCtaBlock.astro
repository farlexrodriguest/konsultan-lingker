---
const { id = 'konsultasi', eyebrow, heading, description, ctaLabel, ctaHref = '/layanan/' } = Astro.props;
---
<section id={id} class="scroll-mt-8 px-5 pb-20">
  <div class="mx-auto max-w-7xl overflow-hidden rounded-3xl bg-emerald-950 px-6 py-10 text-white sm:px-10 sm:py-14 lg:flex lg:items-center lg:justify-between lg:gap-10">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-amber-300/90">{eyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight sm:text-4xl">{heading}</h2>
      <p class="mt-4 leading-7 text-emerald-100/85">{description}</p>
    </div>
    <a href={ctaHref} class="mt-7 inline-flex shrink-0 items-center justify-center rounded-full bg-amber-400 px-7 py-3.5 font-bold text-emerald-950 no-underline transition hover:bg-amber-300 lg:mt-0">{ctaLabel} <span class="ml-2" aria-hidden="true">→</span></a>
  </div>
</section>
