---
import { whatsappLink } from '../../utils/schema.ts';
import { site } from '../../config/site.ts';
import { ui } from '../../config/ui.ts';
const { title, relatedServiceHref, guideCtaText, guideCtaButton } = Astro.props;
---
<div class="guide-cta my-10 rounded-2xl bg-emerald-900 p-8 text-white">
  <h2 class="font-display text-xl font-extrabold tracking-tight text-white">{ui.guide.ctaHeading}</h2>
  <p class="mt-2 leading-7 text-emerald-50">{guideCtaText}</p>
  <div class="mt-6 flex flex-col gap-3 sm:flex-row">
    <a href={relatedServiceHref} class="inline-flex shrink-0 items-center justify-center rounded-full bg-amber-400 px-6 py-3 text-sm font-bold text-emerald-950 no-underline transition hover:bg-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400">{guideCtaButton}</a>
    <a href={whatsappLink(site.whatsapp, `Halo Konsultan Lingker, saya tertarik dengan panduan ${title}`)} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center rounded-full border border-emerald-400/50 px-6 py-3 text-sm font-bold text-white no-underline transition hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400">Hubungi WhatsApp</a>
  </div>
</div>
