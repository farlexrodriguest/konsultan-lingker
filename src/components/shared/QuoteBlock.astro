---
const { id, text, source, class: css } = Astro.props;
---
<blockquote id={id} class={`relative rounded-2xl border-l-4 border-emerald-500 bg-emerald-50 p-6 italic text-zinc-700 ${css?.section ?? ''}`}>
  <p class={`text-lg leading-relaxed ${css?.text ?? ''}`}>"{text}"</p>
  {source && <cite class={`mt-3 block not-italic text-sm font-semibold text-zinc-500 ${css?.source ?? ''}`}>— {source}</cite>}
</blockquote>
