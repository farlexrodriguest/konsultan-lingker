---
/**
 * ComparisonTable — accessible comparison table with header, rows, and optional note.
 *
 * Props:
 * - id: string — anchor id
 * - title: string — section title
 * - intro?: string — optional intro text
 * - headers: string[] — table headers
 * - rows: string[][] — table rows
 * - note?: string — optional note
 *
 * Usage:
 * <ComparisonTable id="compare" title="SLF vs PBG" headers={["Aspek", "SLF", "PBG"]} rows={[["Fungsi", "Kelaikan fungsi", "Persetujuan bangunan"], ["Waktu", "2-4 minggu", "1-3 bulan"]]} />
 */
const { id, title, intro, headers, rows, note } = Astro.props as { id: string; title: string; intro?: string; headers: string[]; rows: string[][]; note?: string };
---
<section id={id} class="my-10" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="text-2xl font-extrabold tracking-tight text-zinc-950 sm:text-3xl">{title}</h2>
  {intro && <p class="mt-3 max-w-3xl leading-7 text-zinc-600">{intro}</p>}
  <div class="mt-6 overflow-x-auto rounded-2xl border border-zinc-200 shadow-sm">
    <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
      <thead class="bg-zinc-900 text-white">
        <tr>{headers.map((header: string) => <th scope="col" class="px-5 py-4 font-bold">{header}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((row: string[], index: number) => (
          <tr class={index % 2 === 0 ? 'bg-white' : 'bg-zinc-50'}>
            {row.map((cell: string) => <td class="border-t border-zinc-200 px-5 py-4 align-top leading-6 text-zinc-700">{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {note && <p class="mt-3 text-sm leading-6 text-zinc-500">{note}</p>}
</section>