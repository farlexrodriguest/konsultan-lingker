---
/**
 * TestimonialGrid — testimonial cards grid.
 *
 * Props:
 * - id: string — anchor id
 * - title: string — section title
 * - items: Array<{quote, name, industry}> — testimonials
 *
 * Usage:
 * <TestimonialGrid id="testimoni" title="Testimoni Klien" items={[{quote: "...", name: "Budi", industry: "Kontraktor"}]} />
 */
const { id, title, items } = Astro.props as { id: string; title: string; items: {quote: string; name: string; industry: string}[] };
const titleId = `${id}-title`;
---
<section id={id} class="py-12 bg-zinc-50" aria-labelledby={titleId}>
  <div class="max-w-7xl mx-auto px-5">
    <h2 id={titleId} class="text-2xl font-bold text-center text-zinc-950 mb-8">{title}</h2>
    <div class="grid gap-6 sm:grid-cols-1 lg:grid-cols-3">
      {items.map((item: {quote: string; name: string; industry: string}) => (
        <figure class="bg-white rounded-xl shadow-sm border border-zinc-200 p-6">
          <blockquote class="text-zinc-600 italic mb-4">“{item.quote}”</blockquote>
          <figcaption class="text-sm font-medium text-zinc-950">
            <span class="block">{item.name}</span>
            <span class="block mt-1 text-zinc-500 font-normal">{item.industry}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>