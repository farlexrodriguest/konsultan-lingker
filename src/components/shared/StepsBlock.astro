---
const { id, heading, items, class: css } = Astro.props;
---
<section id={id} class={`rounded-2xl border border-zinc-200 bg-zinc-50 p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-6 text-2xl font-extrabold text-zinc-950 ${css?.heading ?? ''}`}>{heading}</h2>}
  <ol class={`space-y-6 ${css?.list ?? ''}`}>
    {items.map((item: any, i: number) => (
      <li class={`flex gap-4 ${css?.item ?? ''}`}>
        <span class={`flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-emerald-600 text-sm font-bold text-white ${css?.badge ?? ''}`}>{i + 1}</span>
        <div>
          <p class={`font-semibold text-zinc-950 ${css?.title ?? ''}`}>{item.title}</p>
          <p class={`mt-1 text-sm leading-relaxed text-zinc-600 ${css?.text ?? ''}`}>{item.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
