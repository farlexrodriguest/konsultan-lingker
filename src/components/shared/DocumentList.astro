---
/**
 * DocumentList — grid/list of documents with purpose and mandatory badge.
 *
 * Props:
 * - id: string — anchor id
 * - title: string — section title
 * - intro?: string — optional intro text
 * - items: Array<{name, purpose?, mandatory?}> — document items
 *
 * Usage:
 * <DocumentList id="dokumen" title="Dokumen yang Diperlukan" items={[{name: "KTP", purpose: "Identitas", mandatory: true}]} />
 */
import { ui } from '../../config/ui.ts';
const { id, title, intro, items } = Astro.props;
---
<section id={id} class="my-10" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="text-2xl font-extrabold tracking-tight text-zinc-950 sm:text-3xl">{title}</h2>
  {intro && <p class="mt-3 max-w-3xl leading-7 text-zinc-600">{intro}</p>}
  <ul class="mt-6 grid gap-3 sm:grid-cols-2">
    {items.map((item: {name: string; purpose?: string; mandatory?: boolean}) => (
      <li class="rounded-xl border border-zinc-200 bg-white p-5">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-800" aria-hidden="true">▤</span>
          <div>
            <h3 class="font-bold leading-snug text-zinc-900">{item.name}</h3>
            {item.purpose && <p class="mt-2 text-sm leading-6 text-zinc-600">{item.purpose}</p>}
            {item.mandatory && <span class="mt-3 inline-block rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800">{ui.blocks.documentMandatoryLabel}</span>}
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>