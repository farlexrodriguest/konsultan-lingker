---
/**
 * ArticleCard — ringkasan kartu untuk daftar artikel/panduan.
 *
 * Props:
 * - article: entri koleksi (articles atau guides)
 * - headingLevel?: 2 | 3 — tag heading judul (default 3; pakai 2 jika kartu langsung di bawah h1 halaman)
 * - basePath?: string — awalan rute halaman detail (default '/artikel/')
 * - readLabel?: string — teks tautan baca (default dari ui.article.readMore)
 *
 * Usage:
 * <ArticleCard article={article} />
 * <ArticleCard article={guide} basePath="/panduan/" readLabel={ui.guide.readMore} />
 */
import { ui } from '../../config/ui.ts';
const { article, headingLevel = 3, basePath = '/artikel/', readLabel = ui.article.readMore } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const utcIso = (date: Date) => date.toISOString().replace(/\.\d{3}Z$/, 'Z');
const href = `${basePath}${article.data.slug}/`;
---
<article class="flex h-full flex-col rounded-2xl border border-zinc-200 bg-white p-6 transition hover:-translate-y-1 hover:border-emerald-300 hover:shadow-lg hover:shadow-emerald-900/5">
  {article.data.image && <div class="article-card__media overflow-hidden rounded-xl"><img src={article.data.image} alt="" class="h-40 w-full object-cover" loading="lazy" decoding="async" /></div>}
  {article.data.category && <p class="mt-4 text-xs font-bold uppercase tracking-wider text-emerald-700">{article.data.category}</p>}
  <Heading class="mt-3 font-display text-lg font-bold leading-snug text-zinc-950"><a href={href} class="hover:text-emerald-700">{article.data.title}</a></Heading>
  <p class="mt-3 flex-1 text-sm leading-6 text-zinc-600">{article.data.description}</p>
  <div class="mt-5 flex items-center justify-between text-xs text-zinc-500"><time datetime={article.data.pubDate.toISOString().replace(/\.\d{3}Z$/, 'Z')}>{article.data.pubDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</time><a href={href} class="font-semibold text-emerald-700">{readLabel}</a></div>
</article>
